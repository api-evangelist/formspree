      "name": "List form submissions",
      "request": {
        "name": "List form submissions",
        "description": {
          "content": "Fetch submissions for a given form, identified by its hashid.",
          "type": "text/plain"
        },
        "url": {
          "path": [
            "forms",
            ":hashid",
            "submissions"
          ],
          "host": [
            "{{baseUrl}}"
          ],
          "query": [
            {
              "disabled": false,
              "key": "since",
              "value": "<dateTime>",
              "description": "Return submissions created after this ISO 8601 timestamp."
            },
            {
              "disabled": false,
              "key": "limit",
              "value": "<integer>",
              "description": "Maximum number of submissions to return."
            },
            {
              "disabled": false,
              "key": "offset",
              "value": "<integer>",
              "description": "Number of submissions to skip for pagination."
            },
            {
              "disabled": false,
              "key": "order",
              "value": "<string>",
              "description": "Sort order. Defaults to descending."
            },
            {
              "disabled": false,
              "key": "spam",
              "value": "<boolean>",
              "description": "Whether to include spam-flagged submissions. Defaults to false."
            }
          ],
          "variable": [
            {
              "disabled": false,
              "type": "any",
              "value": "<string>",
              "key": "hashid",
              "description": "(Required) The form's hashid (e.g. as found in the form's action URL)."
            }
          ]
        },
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "method": "GET",
        "auth": null
